; Godot 4.3 project configuration for Bubble Reef Rush — portrait Android-first rhythm runner.
; Engine config file, format version 5 — do not edit manually outside Godot editor.

config_version=5

[application]

config/name="Bubble Reef Rush"
config/features=PackedStringArray("4.3", "Mobile")
run/main_scene="res://scenes/gameplay/MainMenu.tscn"

[autoload]

GameManager="*res://src/core/GameManager.gd"
EventBus="*res://src/core/EventBus.gd"
SaveSystem="*res://src/core/SaveSystem.gd"
BeatConductor="*res://src/rhythm/BeatConductor.gd"
Accessibility="*res://src/core/Accessibility.gd"
GameConstants="*res://src/core/GameConstants.gd"
AssetRegistry="*res://src/core/AssetRegistry.gd"
VisualFactory="*res://src/core/VisualFactory.gd"
ScrollService="*res://src/gameplay/ScrollService.gd"
FXFactory="*res://src/gameplay/FXFactory.gd"
TransitionLayer="*res://src/core/TransitionLayer.gd"
SFXManager="*res://src/audio/SFXManager.gd"
EconomyService="*res://src/core/EconomyService.gd"
AchievementSystem="*res://src/core/AchievementSystem.gd"
AchievementToast="*res://src/ui/AchievementToast.gd"
PlayerSkin="*res://src/gameplay/PlayerSkin.gd"
MutatorSystem="*res://src/core/MutatorSystem.gd"
GhostLibrary="*res://src/core/GhostLibrary.gd"
RuleCardSystem="*res://src/core/RuleCardSystem.gd"
BuildUnlockRegistry="*res://src/buildmode/BuildUnlockRegistry.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

swim_dive={
"deadzone": 0.5,
"events": [Object(InputEventScreenTouch,"resource_local_to_scene":false,"resource_name":"","device":-1,"pressed":true,"position":Vector2(0, 0),"index":0,"canceled":false,"double_tap":false,"script":null)
, Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
